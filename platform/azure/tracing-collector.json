{
  "receivers": {
    "otlp": {
      "protocols": {
        "grpc": {
          "endpoint": "0.0.0.0:4317"
        }
      }
    }
  },
  "exporters": {
    "azuremonitor": {
      "connection_string": "${env:APPLICATIONINSIGHTS_CONNECTION_STRING}"
    }
  },
  "service": {
    "pipelines": {
      "traces": {
        "receivers": [
          "otlp"
        ],
        "exporters": [
          "azuremonitor"
        ]
      }
    }
  }
}
